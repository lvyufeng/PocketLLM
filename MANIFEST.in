include README.md
include README_CN.md
include LICENSE
include requirements.txt
include pyproject.toml

# The vendored GGML tables are read at import time by the quant decoders, and
# package discovery does not ship non-.py files on its own: without this line an
# installed wheel's loader dies at the first codebook read.
recursive-include pocketllm/loader/gguf/vendor *.h *.md

# Each backend's README says what it is waiting for; `pocketllm devices` prints
# the same sentence, and the two have to ship together.
recursive-include pocketllm/backends README.md

# The sdist is pure Python: the native sources moved to relic-core and the C++
# engine to the relic-engine archive, so there is nothing to ship for them and
# nothing here to compile.

# Build trees are environment-specific and are already git-ignored.
prune build
prune dist
